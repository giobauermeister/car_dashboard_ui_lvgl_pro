<!-- One logged threshold change of the Temperature History list -->
<component>
	<previews>
		<preview name="default" width="720" height="140" style_bg_color="0x000000" style_pad_all="28" />
	</previews>

	<api>
		<prop name="time" type="string" default="2:59 AM" help="When the threshold was changed" />
		<prop name="temp" type="string" default="26°" help="The new threshold, with the degree sign" />
	</api>

	<styles>
		<style name="style_main" radius="22" border_width="1" border_color="0x1E1E22" />
	</styles>

	<view extends="box" width="100%" height="88">
		<style name="style_main" />
		<lv_label text="{time}" align="left_mid" x="34">
			<style name="style_text_dim" />
		</lv_label>
		<lv_label text="{temp}" align="right_mid" x="-52" style_text_font="font_temp" style_text_color="{color_white}" />
		<lv_label text="C" align="right_mid" x="-28" y="3">
			<style name="style_text_dim" />
		</lv_label>
	</view>
</component>
