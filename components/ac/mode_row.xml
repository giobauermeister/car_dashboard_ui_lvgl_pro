<!-- One row of the Mode Control list. The gradient fades in while `active` -->
<component>
	<previews>
		<preview name="default" width="720" height="140" style_bg_color="0x1c1c1e" style_pad_all="28" />
	</previews>

	<api>
		<prop name="icon" type="image" help="The a8 icon at the start of the row" />
		<prop name="text" type="string" default="Mode" help="The name of the mode" />
		<prop name="active" type="bool" default="false" bindable="true" help="Show the row as the selected mode" />
	</api>

	<styles>
		<style
			name="style_main"
			bg_opa="255"
			bg_color="{color_bg}"
			bg_grad_color="{color_bg}"
			bg_grad_dir="hor"
			border_width="0"
			radius="0"
			pad_ver="0"
			pad_hor="30"
			pad_column="28"
		>
			<transition props="bg_color bg_grad_color" duration="250" />
		</style>
		<style name="style_active" bg_color="{color_blue}" bg_grad_color="{color_red}" />
		<style name="style_main_pressed" bg_color="0x15161E" bg_grad_color="0x15161E" />
	</styles>

	<view
		extends="lv_obj"
		width="100%"
		height="74"
		scrollable="false"
		flex_flow="row"
		style_flex_cross_place="center"
		style_flex_track_place="center"
		checked="{active}"
	>
		<style name="style_main" />
		<style name="style_main_pressed" selector="pressed" />
		<style name="style_active" selector="checked" />
		<lv_image src="{icon}">
			<style name="style_icon" />
		</lv_image>
		<lv_label text="{text}">
			<style name="style_text_body" />
		</lv_label>
	</view>
</component>
