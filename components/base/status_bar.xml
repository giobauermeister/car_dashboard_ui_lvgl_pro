<!-- Clock on the left, connectivity and battery on the right -->
<component>
	<previews>
		<preview name="default" width="720" height="60" style_bg_color="0x000000" />
	</previews>

	<view extends="box" width="100%" height="56" clickable="false">
		<lv_label text="{subject_clock}" align="left_mid" x="56" style_text_font="font_title" style_text_color="{color_white}" />
		<lv_image src="icon_wifi" align="right_mid" x="-104">
			<style name="style_icon" />
		</lv_image>
		<lv_image src="icon_battery" align="right_mid" x="-56" rotation="900">
			<style name="style_icon" />
		</lv_image>
	</view>
</component>
